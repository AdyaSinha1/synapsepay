# ---- PayPal REST API v2 (developer sandbox) ----
# Create at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ---- Google Gemini (Neural Arbiter rubric scoring) ----
# Get a key at https://aistudio.google.com/app/apikey
# Leave empty to use the deterministic heuristic fallback rubric.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Arbitration tuning ----
ARBITER_THRESHOLD=0.85
PARTIAL_THRESHOLD=0.80
REMEDIATION_FLOOR=0.70
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_MB=256

# ---- Payment reliability ----
PAYMENT_RETRIES=2
RETRY_BASE_DELAY_SECONDS=0.3

# ---- Persistence ----
# SQLite for dev (default). Point DATABASE_URL at Postgres in production
# (Neon/Supabase/Render). Apply migrations with: cd backend && alembic upgrade head
DATABASE_URL=
# PERSISTENCE_ENABLED=false disables disk storage (memory-only demo mode)

# ---- Auth ----
# REQUIRE_AUTH=true enforces bearer tokens on business routes (default off
# while the frontend login ships in Phase 3). Session TTL in hours.
REQUIRE_AUTH=false
SESSION_TTL_HOURS=72

# ---- Deployment ----
# Comma-separated list of allowed frontend origins (browser CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
